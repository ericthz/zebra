# ---- zebra 服务端配置示例（复制为 .env 后按需填写）----

# LLM（主模型，Ollama 原生，支持流式）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:0.8b-mlx

# 备选模型（OpenAI 兼容，主模型故障自动降级）
# FALLBACK_BASE_URL=http://localhost:11434/v1
# FALLBACK_MODEL=qwen2.5:7b

# Anthropic 备选
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# 长期记忆（可选，Qdrant）
QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=zebra_mem

# 嵌入（默认用 Ollama 本地；设置 OPENAI_API_KEY 则改用 OpenAI 兼容）
EMBED_MODEL=nomic-embed-text:v1.5
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBED_MODEL=text-embedding-3-small
# EMBED_VECTOR_SIZE=768

# RBAC API Key
ADMIN_KEY=admin-key
USER_KEY=user-key

# 服务监听地址
ADDR=:8080

# ---- 诊断日志 ----
# zebra CLI 诊断日志路径（默认 zebra.log；置 off 输出到 stderr）
# ZEBRA_LOG=zebra.log
# server JSON 日志双写文件路径（默认 server.log；置 off 仅输出 stdout）
# LOG_FILE=server.log

# ---- MCP 远端工具 ----
# 模式：stdio（本地子进程）/ http（远端服务）；设置即启用
# MCP_MODE=
# MCP_COMMAND=
# MCP_HTTP_URL=http://localhost:9000
# HTTP 模式访问令牌（设置即要求 Bearer，防未授权调用）
# MCP_HTTP_TOKEN=

# ---- P2 本地执行沙箱 ----
# 工作目录白名单（仅此处可读写/执行命令）
EXEC_WORKDIR=workspace
# 只读模式（默认 1=开启：禁止写文件/执行命令，更安全）
EXEC_READONLY=1

# ---- P4 主动出站 ----
# Webhook 通知地址（对话完成自动推送；留空关闭）
# WEBHOOK_URL=http://your-system/hook
# WEBHOOK_SECRET=

# ---- P5 语义缓存 ----
# 缓存最大条目数
# CACHE_MAX_ENTRIES=200
# 语义相似度命中阈值（0~1，越大越严格，默认 0.92）
# CACHE_THRESHOLD=0.92

# ---- HTTP 容错 ----
# LLM 请求超时秒数（本地大模型首 token 慢，默认 60）
# HTTP_TIMEOUT=60
# 失败重试次数（默认 1）
# HTTP_RETRIES=1
# 退避基数毫秒（指数退避，默认 300）
# HTTP_BACKOFF_MS=300
# 熔断器：连续失败阈值（默认 5）
# CIRCUIT_THRESHOLD=5
# 熔断恢复冷却秒数（默认 30）
# CIRCUIT_COOLDOWN_SEC=30

# ---- Agent 执行参数 ----
# ReAct 推理-行动最大步数（默认 6；达到上限仍未收敛会报错中止）
# REACT_MAX_STEPS=6
# 自一致性采样份数（mode=consistent，默认 3）
# SELF_CONSISTENT_SAMPLES=3
# 上下文窗口 token 预算（默认 4000）
# CONTEXT_MAX_TOKENS=4000
# 对话摘要最大字符数（默认 600）
# SUMMARY_MAX_CHARS=600
# 最大工具调用轮数（默认 5；达到上限未产出会报错）
# MAX_TOOL_TURNS=5
# 查询改写：置 1 开启（RAG 检索前把口语问题改写成检索友好句式，P48）
# ZEBRA_QUERY_REWRITE=0
# 摘要压缩器：置 llm 用 LLM 语义摘要，否则截断式（默认）
# ZEBRA_SUMMARIZER=truncate

# ---- P8 RAG 知识库 ----
# 文档分块大小 / 重叠（字符数，默认 600/100）
# RAG_CHUNK_SIZE=600
# RAG_CHUNK_OVERLAP=100
# 检索后重排序：置 1 开启（向量+BM25 混合检索后按得分重排）
# ZEBRA_RAG_RERANK=0

# ---- P21 在线评测/影子模式 ----
# 候选模型名（设置即开启影子评测；候选默认走 Ollama 同后端）
# ZEBRA_SHADOW_MODEL=qwen2.5:7b
# 候选走 OpenAI 兼容后端时置 1（可配合 ZEBRA_SHADOW_BASE_URL 指网关/新模型）
# ZEBRA_SHADOW_OPENAI=0
# ZEBRA_SHADOW_BASE_URL=
# 自动采样率百分比 0~100（0=仅显式触发），默认 10
# ZEBRA_SHADOW_SAMPLE=10
# 影子评测记录上限（默认 200）
# SHADOW_STORE_MAX=200
# 独立评审模型（Judge）：默认用生产 router，避免"生产模型自己评自己"
# JUDGE_BASE_URL=
# JUDGE_OPENAI=0
# JUDGE_MODEL=
# JUDGE_API_KEY=
# 离线评测用例目录（默认 test/eval/cases）
# EVAL_CASES_DIR=test/eval/cases

# ---- P22 记忆画像 ----
# 画像事实保鲜期（小时，默认 720 = 30 天；过期自动隐藏/清理）
# PROFILE_TTL_HOURS=720
# 画像抽取方式：默认 LLM 语义抽取 + 规则回退；置 0 退回纯规则抽取
# PROFILE_LLM=1
# 画像过期清扫周期（分钟，默认 60）
# PROFILE_SWEEP_MINUTES=60

# ---- P25 语音交互（OpenAI 兼容 ASR/TTS）----
# 设置 VOICE_BASE_URL 即开启语音 API（可指 OpenAI 或任意兼容网关）
# VOICE_BASE_URL=https://api.openai.com/v1
# VOICE_API_KEY=
# VOICE_ASR_MODEL=whisper-1
# VOICE_TTS_MODEL=tts-1
# VOICE_TONE=alloy

# ---- P28 水平扩展：Redis 会话存储 ----
# 设置 REDIS_URL 后会话不再绑单机内存，多副本共享状态
# REDIS_URL=127.0.0.1:6379
# REDIS_PASSWORD=
# REDIS_DB=0